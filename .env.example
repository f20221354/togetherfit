# togetherfit settings. Copy to .env (Docker) or .env.local (development) and fill in.
# Full descriptions: README.md → Environment variables.

# --- Required -------------------------------------------------------------
DOMAIN=togetherfit.example                      # your domain (Docker/Caddy only)
DATABASE_URL=postgres://user:password@host:5432/togetherfit
AUTH_SECRET=                                    # openssl rand -base64 48
CRON_SECRET=                                    # openssl rand -hex 32

# --- Email (choose SES, or SMTP until SES is ready) ------------------------
SES_REGION=                                     # e.g. ap-south-1
EMAIL_FROM=                                     # e.g. togetherfit <no-reply@togetherfit.example>
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

# --- Bot check on sign-up / password reset ---------------------------------
CAPTCHA=turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                 # read at build time

# --- Trust & safety --------------------------------------------------------
VERIFICATION=mock                               # mock (not real!) | off; aws planned
MOCK_VERIFICATION_OUTCOME=pass

# --- Realtime chat ---------------------------------------------------------
REALTIME=sse                                    # sse (own server) | ably (Vercel) | poll
ABLY_API_KEY=

# --- Networking ------------------------------------------------------------
TRUSTED_PROXY_HOPS=1                            # proxies in front of the app
CLIENT_IP_HEADER=                               # e.g. cf-connecting-ip behind Cloudflare
DATABASE_SSL=                                   # false for a local DB without TLS
DATABASE_CA_CERT=

# --- Monitoring ------------------------------------------------------------
ERROR_WEBHOOK_URL=                              # Slack/Discord webhook for crash alerts

# --- Optional --------------------------------------------------------------
GROQ_API_KEY=                                   # AI Coach answers
